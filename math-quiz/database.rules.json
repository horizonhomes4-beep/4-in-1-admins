{
  "rules": {
    ".read": false,
    ".write": false,
    "access": {
      "admins": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('access/admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (root.child('access/admins').child(auth.uid).val() === true || (auth.uid === $uid && !root.child('access/admins').exists() && newData.val() === true))",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      },
      "adminProfiles": {
        "$uid": {
          ".read": "auth != null && root.child('access/admins').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('access/admins').child(auth.uid).val() === true"
        }
      }
    },
    "mathQuiz": {
      ".read": "auth != null && root.child('access/admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('access/admins').child(auth.uid).val() === true",
      "students": {
        "$studentId": {
          ".read": "auth != null && auth.uid === $studentId"
        }
      },
      "questions": {
        ".indexOn": ["classId"],
        ".read": "auth != null && root.child('mathQuiz/students').child(auth.uid).exists() && root.child('mathQuiz/students').child(auth.uid).child('active').val() !== false"
      },
      "assignments": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "deviceLocks": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('mathQuiz/students').child(auth.uid).exists() && (!data.exists() || data.child('state').val() === 'unlocked') && newData.child('state').val() === 'locked'",
          ".validate": "newData.hasChildren(['deviceId','state']) && newData.child('deviceId').isString() && newData.child('deviceId').val().length <= 80 && (newData.child('state').val() === 'locked' || newData.child('state').val() === 'unlocked') && (!newData.child('label').exists() || (newData.child('label').isString() && newData.child('label').val().length <= 80))"
        }
      },
      "deviceRequests": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('mathQuiz/students').child(auth.uid).exists() && newData.child('status').val() === 'pending' && (!data.exists() || data.child('status').val() !== 'pending')",
          ".validate": "newData.hasChildren(['studentId','status','requestedAt']) && newData.child('studentId').val() === $uid && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 300))"
        }
      },
      "sessions": {
        ".indexOn": ["studentId", "completedAt"],
        ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
        "$id": {
          ".read": "auth != null && data.child('studentId').val() === auth.uid",
          ".write": "auth != null && !data.exists() && newData.child('studentId').val() === auth.uid && root.child('mathQuiz/deviceLocks').child(auth.uid).child('state').val() === 'locked' && newData.child('deviceId').val() === root.child('mathQuiz/deviceLocks').child(auth.uid).child('deviceId').val()",
          ".validate": "newData.hasChildren(['studentId','score','total','correct','completedAt']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 100 && newData.child('total').isNumber() && newData.child('total').val() > 0 && newData.child('correct').isNumber() && newData.child('correct').val() <= newData.child('total').val()"
        }
      },
      "sessionAnswers": {
        "$id": {
          ".read": "auth != null && data.child('studentId').val() === auth.uid",
          ".write": "auth != null && !data.exists() && newData.child('studentId').val() === auth.uid"
        }
      }
    }
  }
}
